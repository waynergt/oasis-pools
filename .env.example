# Copy this file to .env and set the endpoint that receives quote requests (JSON POST).
# Example with Formspree: https://formspree.io/f/your-id
VITE_FORM_ENDPOINT=

# Public site URL. Default: https://www.oasispoolsdenver.com
VITE_SITE_URL=

# Optional: override the GA4 measurement ID (default G-RXH9QL4T1L, tracks only on the live domain).
VITE_GA_ID=
