# Copy this file to .env and set the endpoint that receives quote requests (JSON POST).
# Example with Formspree: https://formspree.io/f/your-id
VITE_FORM_ENDPOINT=

# Public site URL (custom domain once it's live). Default: https://oasis-pools-six.vercel.app
VITE_SITE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = analytics off.
VITE_GA_ID=
